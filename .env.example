# Тайни за Cloudflare: локално в .dev.vars, в облака с `npx wrangler secret put ИМЕ`
# Писма от контактната форма (Gmail API, виж scripts/gmail-token.mjs)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
CONTACT_TO=
# Чатбот (по желание)
GEMINI_API_KEY=
# Админ панел: код за създаване на първия главен админ (после може да се изтрие)
ADMIN_SETUP_CODE=
# само локално (next dev): вход без Access
DEV_ADMIN_EMAIL=
